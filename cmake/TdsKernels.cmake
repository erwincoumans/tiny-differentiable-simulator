# Batched CPU and CUDA kernels generated by tds::KernelCodegen
# (src/utils/kernel_codegen.hpp), see examples/kernels/g1.
#
# Options:
#   TDS_KERNELS_CUDA      compile the CUDA kernels when a CUDA compiler is found
#   TDS_GENERATE_KERNELS  regenerate the kernels at build time with their
#                         generator, instead of using the checked-in sources.
#                         Requires USE_CPPAD.
#
# tds_add_kernels(<name>
#   GENERATED_DIR <dir>        directory of the checked-in generated sources
#   GENERATOR <source>         program that writes the generated sources to the
#                              directory given as its first argument
#   [GENERATOR_INCLUDE_DIRS <dirs>]
# )
# creates the static library <name>_kernels, which provides
# <name>_kernel_model() from <name>_kernels.h. With TDS_GENERATE_KERNELS, the
# target update_<name>_kernels copies the generated sources to GENERATED_DIR.
#
# This file must be included from the top-level CMakeLists.txt, because it
# enables the CUDA language.

option(TDS_KERNELS_CUDA "Compile the generated kernels with CUDA when a CUDA compiler is found" ON)
option(TDS_GENERATE_KERNELS "Regenerate the kernels at build time instead of using the checked-in sources (requires USE_CPPAD)" OFF)

set(TDS_HAVE_CUDA_KERNELS OFF)
if(TDS_KERNELS_CUDA)
  include(CheckLanguage)
  check_language(CUDA)
  if(CMAKE_CUDA_COMPILER)
    if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES AND
       CMAKE_VERSION VERSION_GREATER_EQUAL 3.24)
      set(CMAKE_CUDA_ARCHITECTURES native)
    endif()
    enable_language(CUDA)
    find_package(CUDAToolkit REQUIRED)
    set(CMAKE_CUDA_STANDARD 17)
    set(TDS_HAVE_CUDA_KERNELS ON)
    message(STATUS "Generated kernels: CPU and CUDA (${CMAKE_CUDA_ARCHITECTURES})")
  else()
    message(STATUS "Generated kernels: CPU only, no CUDA compiler found")
  endif()
endif()

find_package(OpenMP)

function(tds_add_kernels name)
  cmake_parse_arguments(ARG "" "GENERATED_DIR;GENERATOR" "GENERATOR_INCLUDE_DIRS" ${ARGN})
  set(headers ${name}_kernels.h ${name}_kernels_impl.h)
  set(cpu_sources ${name}_kernels.cpp ${name}_kernels_cpu_float.cpp
      ${name}_kernels_cpu_double.cpp)
  set(cuda_sources ${name}_kernels_cuda.cu ${name}_kernels_cuda_float.cu
      ${name}_kernels_cuda_double.cu)

  if(TDS_GENERATE_KERNELS)
    if(NOT USE_CPPAD)
      message(FATAL_ERROR "TDS_GENERATE_KERNELS requires USE_CPPAD=ON")
    endif()
    set(dir ${CMAKE_CURRENT_BINARY_DIR}/${name}_kernels)
    add_executable(${name}_codegen ${ARG_GENERATOR})
    target_compile_definitions(${name}_codegen PRIVATE USE_CPPAD USE_CPPAD_CODEGEN)
    target_include_directories(${name}_codegen PRIVATE
      ${PROJECT_SOURCE_DIR}/src ${PROJECT_SOURCE_DIR}/third_party
      ${ARG_GENERATOR_INCLUDE_DIRS})
    target_link_libraries(${name}_codegen PRIVATE
      tinyxml2 Eigen3::Eigen differentiation ${CMAKE_DL_LIBS})
    set(outputs ${headers} ${cpu_sources} ${cuda_sources})
    list(TRANSFORM outputs PREPEND ${dir}/)
    add_custom_command(
      OUTPUT ${outputs}
      COMMAND ${name}_codegen ${dir}
      WORKING_DIRECTORY ${PROJECT_SOURCE_DIR}/data
      DEPENDS ${name}_codegen
      COMMENT "Generating the ${name} kernels")
    add_custom_target(update_${name}_kernels
      COMMAND ${CMAKE_COMMAND} -E make_directory ${ARG_GENERATED_DIR}
      COMMAND ${CMAKE_COMMAND} -E copy ${outputs} ${ARG_GENERATED_DIR}
      DEPENDS ${outputs}
      COMMENT "Copying the generated ${name} kernels to ${ARG_GENERATED_DIR}")
  else()
    set(dir ${ARG_GENERATED_DIR})
  endif()

  list(TRANSFORM cpu_sources PREPEND ${dir}/)
  add_library(${name}_kernels STATIC ${cpu_sources})
  target_include_directories(${name}_kernels PUBLIC ${dir} ${PROJECT_SOURCE_DIR}/src)
  set_target_properties(${name}_kernels PROPERTIES POSITION_INDEPENDENT_CODE ON)
  # the generated code is too slow without optimization, also in debug builds
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    set_source_files_properties(${cpu_sources} PROPERTIES COMPILE_OPTIONS -O2)
  endif()
  if(OpenMP_CXX_FOUND)
    target_link_libraries(${name}_kernels PUBLIC OpenMP::OpenMP_CXX)
  endif()
  if(TDS_HAVE_CUDA_KERNELS)
    list(TRANSFORM cuda_sources PREPEND ${dir}/)
    target_sources(${name}_kernels PRIVATE ${cuda_sources})
    target_compile_definitions(${name}_kernels PRIVATE TDS_KERNELS_CUDA)
    set_source_files_properties(${cuda_sources} PROPERTIES COMPILE_OPTIONS -O3)
    target_link_libraries(${name}_kernels PUBLIC CUDA::cudart)
  endif()
endfunction()
